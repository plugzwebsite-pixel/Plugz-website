# Copy to .env and fill in. Never commit real secrets.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pluggz?schema=public"

# Rate limiting. Falls back to process memory when unset, which is fine for
# local development but not for production — an in-memory counter is wiped by
# every restart, so an attacker only has to wait for a deploy.
REDIS_URL="redis://127.0.0.1:6379"

# Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this signs every user out.
AUTH_SECRET=""
AUTH_COOKIE_NAME="pluggz_session"
SESSION_MAX_AGE_DAYS="7"

# "dev" captures mail at /dev/mailbox instead of sending.
# "brevo" sends with only a verified sender address — no domain verification
# needed, 300/day free. "resend" needs the domain verified first.
EMAIL_PROVIDER="dev"            # dev | brevo | resend
EMAIL_FROM="Pluggz <hello@pluggzofficial.co.uk>"
BREVO_API_KEY=""
RESEND_API_KEY=""

# Canonical origin. Used for Open Graph tags, verification and reset links,
# and the tracking links creators publish — so it must be the real domain in
# production, not a preview URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@pluggzofficial.co.uk"
SEED_ADMIN_PASSWORD="change-me"
