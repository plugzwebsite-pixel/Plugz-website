# Copy to .env and fill in. Never commit real secrets.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plugz_dev?schema=public"

AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
AUTH_COOKIE_NAME="plugz_session"
SESSION_MAX_AGE_DAYS="7"

EMAIL_PROVIDER="dev"            # "dev" | "resend"
EMAIL_FROM="Plugz <hello@plugz.com>"
RESEND_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@plugz.com"
SEED_ADMIN_PASSWORD="change-me"
