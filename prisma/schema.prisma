// Pluggz data model (auth + roles for the MVP frontend phase).
// Datastore: self-hosted PostgreSQL (see infrastructure proposal).

generator client {
  provider      = "prisma-client-js"
  // native for local dev; the others cover Railway (Debian) and Netlify (RHEL/Lambda).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHOPPER
  CREATOR
  BRAND
  ADMIN
}

enum CreatorStatus {
  PENDING // application submitted, awaiting Lisa/Rachel review
  APPROVED // live on the platform
  DECLINED // rejected in review
  SUSPENDED // temporarily disabled
}

// How the creator record was created. Drives the dual-consent flow.
enum ApplicationSource {
  SELF_SERVE // creator applied themselves
  ADMIN_ADDED // admin created on their behalf; creator must still confirm
}

enum WaitlistInterest {
  CREATOR
  SHOPPER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CREATOR)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creatorProfile      CreatorProfile?
  shopperProfile      ShopperProfile?
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  wishlist            WishlistItem[]
  reviewedVideos      CreatorVideo[]
  siteEdits           SiteContent[]
  campaignsCreated    Campaign[]

  // Set only for BRAND accounts: the brand whose figures this person may see.
  // A brand can have several contacts; each one is tied to exactly one brand,
  // which is what scopes every query on the brand dashboard.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([brandId])
}

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  handle    String  @unique // storefront slug, e.g. "freyasinclair" -> pluggz.com/@freyasinclair
  category  String
  city      String?
  bio       String?
  avatarUrl String?

  status CreatorStatus     @default(PENDING)
  source ApplicationSource @default(SELF_SERVE)

  // Approving somebody and putting them on the front page are two different
  // decisions. Every approved creator gets a storefront; only the ones the team
  // chooses appear on the homepage wall. Otherwise a test account or a very
  // small creator lands next to the headline names the moment they sign up.
  featured Boolean @default(false)

  // Dual-consent: admin-added creators must log in and release their profile.
  profileReleasedAt DateTime?

  // --- getting paid -------------------------------------------------------
  //
  // The creator's own account at Stripe, created through Connect Express.
  //
  // Only the identifier lives here. Their bank details, their address and
  // whatever Stripe needs to verify them are entered on Stripe's own pages and
  // held by Stripe, never by us. That is the whole reason for choosing Express:
  // a platform that never sees a bank account cannot leak one.
  stripeAccountId String? @unique

  // Stripe's answer to "may this account receive money yet", copied here so a
  // payout run does not have to ask about every creator one at a time. Set from
  // the account.updated webhook and refreshed when a creator returns from
  // onboarding, so it is a cache of Stripe's opinion and never our own.
  stripePayoutsEnabled Boolean   @default(false)
  stripeOnboardedAt    DateTime?

  /// What Stripe is still waiting for, in its own words, so "not ready yet"
  /// can tell the creator which document is missing.
  stripeRequirement String?

  // Tick-box terms acceptance, automatically timestamped + versioned.
  termsVersion    String?
  termsAcceptedAt DateTime?

  socials   SocialHandle[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  collections        Collection[]
  creatorProducts    CreatorProduct[]
  payouts            Payout[]
  commissionOverride CommissionOverride?
  campaignCreators   CampaignCreator[]

  @@index([status])
}

/**
 * A shopper's account.
 * Shoppers browse and buy without ever signing in, because there is no checkout
 * on Pluggz, so an account exists for one reason: the shopper chooses to be
 * known to us. That makes consent the whole point of this record rather than a
 * footnote, which is why the marketing opt-in is stored with the timestamp and
 * the wording version it was given against. A name and an email with no
 * evidence of how they were obtained is not a list anyone can lawfully send to.
 */
model ShopperProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  city String?

  // Categories the shopper picked at sign-up. Kept so the team can send the
  // beauty edit to the people who asked for beauty, rather than everyone.
  interests String[]

  // Opt-in, never assumed. Unticked at sign-up and unticked here by default:
  // a pre-ticked box is not consent under UK GDPR / PECR.
  marketingOptIn    Boolean   @default(false)
  marketingOptInAt  DateTime?
  marketingOptOutAt DateTime?

  // The terms wording in force when they joined, timestamped the same way the
  // creator agreement is.
  termsVersion    String?
  termsAcceptedAt DateTime?

  // Free text, e.g. "web" or a creator handle, so the team can see which
  // storefront actually brought a shopper in.
  signupSource String?

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketingOptIn])
  @@index([createdAt])
}

model SocialHandle {
  id        String         @id @default(cuid())
  profileId String
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  platform  String // instagram | tiktok | youtube | ...
  handle    String
  url       String?
  followers Int     @default(0)

  @@index([profileId])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  ONBOARDED
  DECLINED
}

/**
 * A brand asking to work with Pluggz.
 * Deliberately not a signup. Brands can't self-serve an account because the
 * commission rate, return window and settlement terms are negotiated before
 * there is anything to show them, so this captures the lead, and the first
 * question from the Brand Onboarding Checklist, and lands in the admin queue.
 */
model BrandEnquiry {
  id      String  @id @default(cuid())
  brand   String
  website String?

  contactName  String
  contactEmail String
  contactRole  String?

  // The question that decides everything downstream: a brand already on a
  // network is a different onboarding path from a direct deal.
  hasAffiliateProgramme Boolean @default(false)
  networkName           String?

  categories String? // free text: what they sell
  message    String?

  status EnquiryStatus @default(NEW)
  note   String? // admin's own note

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model WaitlistEntry {
  id        String           @id @default(cuid())
  name      String
  email     String           @unique
  handle    String?
  interest  WaitlistInterest @default(CREATOR)
  createdAt DateTime         @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tracking engine, catalogue and commission pipeline.
//
// Money is stored in minor units (pence) as Int so no rounding ever happens in
// floating point. Rates are percentages, e.g. 8.00 means 8%.
// ---------------------------------------------------------------------------

// How a sale gets attributed back to Pluggz for a given brand.
enum TrackingMethod {
  PLUGGZ_DIRECT // Pluggz's own link, direct brand deal, the launch default
  DISCOUNT_CODE // unique code per creator; for brands with no technical setup
  PIXEL // pixel/JS snippet on the brand's order confirmation page
  NETWORK // third-party network deep link, infrastructure only for now
}

enum BrandStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Brand {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  websiteUrl String?
  logoUrl    String?
  status     BrandStatus @default(DRAFT)

  // The first onboarding question. Decides which field set below applies.
  hasAffiliateProgramme Boolean        @default(false)
  trackingMethod        TrackingMethod @default(DISCOUNT_CODE)

  // Defaults to OTHER because every brand added before this column was asked
  // no such question, and guessing Shopify for them would have the admin screen
  // offer a pixel to shops that cannot run one.
  platform StorePlatform @default(OTHER)

  // Network path. Built now, unusable until Pluggz is accepted as a
  // sub-affiliate (Awin and Sovrn have both declined pending traffic).
  networkName     String?
  publisherId     String?
  deepLinkPattern String? // {DEST} and {CLICKREF} are substituted at redirect time

  // Direct-deal path: the real launch path today.
  attributionWindowDays Int     @default(30)
  invoicingDetails      String?

  // Shared commercial terms, both paths.
  commissionRate   Decimal @default(11.00) @db.Decimal(5, 2) // % Pluggz earns from the brand
  returnWindowDays Int     @default(30) // gates Pending -> Verified
  settlementDays   Int     @default(30) // how long after Verified the brand pays
  contactName      String?
  contactRole      String?
  contactEmail     String?

  // Credentials the brand's own server uses to report a sale. The key
  // identifies them; the secret signs the body, which is what stops anyone
  // else claiming sales against their account. Issued at onboarding, and
  // never shown again after the one time it is handed over.
  trackingKey    String? @unique
  trackingSecret String?

  // Placeholder launch content. Deleting these cascades through products,
  // listings and tracking links, so the demo catalogue can be cleared in one
  // query the moment Lisa and Rachel's real brands are loaded.
  seeded Boolean @default(false)

  // The demonstration shop. It is a genuine brand row with genuine credentials,
  // because the walkthrough has to drive the same code a real integration does.
  // But it is a fictional label, and its listing sits on a real influencer's
  // storefront. It must never reach the catalogue a shopper browses.
  demo Boolean @default(false)

  products              Product[]
  returnWindowOverrides ReturnWindowOverride[]
  commissionOverride    CommissionOverride?
  users                 User[] // brand-side contacts with dashboard access

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]

  @@index([status])
}

// Temporary, date-bound extension on top of a brand's normal return window
// (Christmas, Black Friday). Deliberately separate from returnWindowDays so the
// base figure never has to be edited and remembered back.
model ReturnWindowOverride {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  label    String // e.g. "Christmas 2026"
  days     Int
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())

  @@index([brandId, startsAt, endsAt])
}

// Master product record. One row per real-world product; every creator that
// plugs it attaches their own CreatorProduct review page to this same record,
// so the catalogue never accumulates duplicates of the same item.
model Product {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  imageUrl    String?
  pricePence  Int?
  currency    String  @default("GBP")
  category    String

  // Canonical brand URL: the dedupe key that makes shared records work.
  sourceUrl String @unique

  creatorProducts CreatorProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, slug])
  @@index([category])
}

// A single creator's page for a single product: pluggz.com/@handle/<slug>.
model CreatorProduct {
  id        String         @id @default(cuid())
  profileId String
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  slug   String
  review String?
  rating Int? // 1-5

  /// Chosen by the team for the homepage. Separate from `live`, which is the
  /// creator's own decision about whether to show it at all: being on their
  /// storefront and being on the front page are two different things, and one
  /// of them is not the creator's to grant.
  featured Boolean @default(false)

  views     ProductView[]
  campaigns CampaignListing[]

  /// Kept for the handful of listings that carry a plain file address. New
  /// video goes through CreatorVideo and Cloudflare Stream; this is read as a
  /// fallback so nothing already published disappears.
  videoUrl String?
  video    CreatorVideo?

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  live      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingLink TrackingLink?
  sales        Sale[]
  savedBy      WishlistItem[]

  @@unique([profileId, productId]) // one page per creator per product
  @@unique([profileId, slug])
  @@index([live])
}

// Creator-defined grouping within their own storefront (Travel, Fitness, ...),
// separate from the platform-level categories.
model Collection {
  id        String         @id @default(cuid())
  profileId String
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  position Int    @default(0)

  creatorProducts CreatorProduct[]

  createdAt DateTime @default(now())

  @@unique([profileId, slug])
}

/// Where a campaign is in its life.
enum CampaignStatus {
  DRAFT
  LIVE
  ENDED
}

/// A storefront the team issues, rather than one a creator built.
///
/// Everything public on Pluggz so far belongs to exactly one creator, which is
/// right for the ordinary case and wrong for the thing brands actually buy: a
/// season, a launch, a story that several creators tell together. That cannot
/// live on any one storefront, because no one of them owns it, and it cannot be
/// self served, because the arrangement is commercial and agreed before anyone
/// posts anything.
///
/// A campaign gathers listings that already exist rather than creating new
/// ones. Every listing it shows keeps its own tracking link, its own creator
/// and its own commission terms, so a sale made through a campaign page is
/// attributed exactly as it would have been anywhere else. The campaign is a
/// way of presenting work, never a second set of books.
model Campaign {
  id   String @id @default(cuid())
  name String
  slug String @unique

  tagline      String?
  description  String?
  heroImageUrl String?

  /// The brand paying for it, when one is. A campaign can also be ours alone,
  /// which is why this is optional rather than assumed.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  status   CampaignStatus @default(DRAFT)
  startsAt DateTime?
  endsAt   DateTime?

  creators CampaignCreator[]
  listings CampaignListing[]

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

/// A creator taking part. Position is the order they appear in.
model CampaignCreator {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  profileId String
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@unique([campaignId, profileId])
}

/// A listing the campaign shows.
///
/// Points at a CreatorProduct, never at a Product, because the tracking link
/// and the creator are attached to the listing. Pointing at the product would
/// mean deciding at render time whose link to use, which is exactly the
/// decision that must not be improvised.
model CampaignListing {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorProductId String
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@unique([campaignId, creatorProductId])
}

// Pluggz's own affiliate link.
//
// `code` is generated once and NEVER changes. `destinationUrl` is mutable.
// That split is deliberate: creators publish pluggz.com/go/<code> to Instagram
// and TikTok immediately, using a placeholder destination, and when the real
// brand affiliate URL lands we swap only the destination. Every link already
// out in the world keeps working, and its click history stays intact.
model TrackingLink {
  id   String @id @default(cuid())
  code String @unique

  creatorProductId String         @unique
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  destinationUrl String
  isPlaceholder  Boolean @default(true)
  discountCode   String? // per-creator code when the brand tracks that way

  // Denormalised running total. The Click rows stay the source of truth; this
  // exists so "trending" can be ordered in the database instead of by pulling
  // every product into memory and counting.
  clickCount Int @default(0)

  clicks Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPlaceholder])
}

model Click {
  id             String       @id @default(cuid())
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  clickedAt DateTime @default(now())
  sessionId String // attribution cookie value, ties a later sale back to this click
  ipHash    String? // hashed, never the raw IP
  userAgent String?
  referrer  String?
  country   String?

  sales Sale[]

  @@index([trackingLinkId, clickedAt])
  @@index([sessionId])
}

// Brand-reported outcome of a sale.
enum SaleStatus {
  PENDING
  APPROVED
  RETURNED
  CANCELLED
  REJECTED
}

/// What the brand's shop is built on.
///
/// This decides which integration we hand them, and it is the first question
/// worth asking. A Shopify shop can be tracking sales in five minutes with a
/// pixel the owner pastes into an admin screen, no developer involved. Anything
/// else needs someone who can put a signed call on their server, which is a
/// different conversation and a much slower one.
enum StorePlatform {
  SHOPIFY
  WOOCOMMERCE
  OTHER
}

/// How a sale reached us, which is really a question about how much it can be
/// trusted. A postback is signed by the brand's server with a secret only they
/// and we hold, so its value cannot be tampered with. A pixel runs in the
/// shopper's own browser, where the key is visible and the reported value can
/// be edited by anyone willing to open dev tools, so it is a claim rather than
/// a fact and must be reconciled against the brand's orders before payout.
/// A promotional clip a creator recorded for one of their listings.
///
/// One per listing, which is why the relation is unique: the storefront shows a
/// product with its video, not a gallery, and letting a listing carry five of
/// them would only raise the question of which one plays.
///
/// Kept apart from CreatorProduct rather than added as six more columns on it,
/// because moderation needs a queue with an audit trail: who looked, when, and
/// why something came down. That does not belong wedged into the listing row.
model CreatorVideo {
  id String @id @default(cuid())

  creatorProductId String         @unique
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  /// Cloudflare's own identifier. Everything about the file is asked of them
  /// using this; we store no bytes.
  uid String @unique

  state  VideoState  @default(UPLOADING)
  review VideoReview @default(PENDING)

  durationSeconds Int?
  thumbnailUrl    String?
  /// Set once Cloudflare says the clip is playable, so a half-uploaded file is
  /// never put in front of a shopper.
  readyAt         DateTime?

  removedReason String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The moderation queue reads these two together: what is live and unlooked at.
  @@index([review, state])
  @@index([createdAt])
}

/// Somebody looking at a product page on Pluggz itself.
///
/// Clicks measure what left for a brand's site; this measures what was looked
/// at and did not. Without both, a product with two hundred views and one click
/// is indistinguishable from one nobody ever saw, and those two need entirely
/// different conversations with the brand.
///
/// Recorded from the browser rather than during the render, because the product
/// pages are prerendered and counting on the server would make every one of
/// them dynamic. Bots are excluded on the way in, the same as clicks.
model ProductView {
  id String @id @default(cuid())

  creatorProductId String
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  /// The same attribution session a click carries, so a view and the click it
  /// led to can be tied together.
  sessionId String
  viewedAt  DateTime @default(now())

  @@index([creatorProductId, viewedAt])
  @@index([viewedAt])
}

/// Editable copy and placements for the public homepage.
///
/// A key and a value rather than a column per field. The team wants to change a
/// headline or swap a promotional strip without a release, and the alternative
/// is a migration every time somebody rewords a sentence.
model SiteContent {
  key   String @id
  value String

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Where a video is in Cloudflare's hands.
///
/// The file never touches this server. A creator's browser uploads straight to
/// Cloudflare using a one-time address, which is what keeps a platform full of
/// phone footage from needing storage or bandwidth of its own.
enum VideoState {
  UPLOADING // the one-time address exists, the file has not arrived yet
  PROCESSING // Cloudflare is encoding it
  READY // playable
  FAILED // Cloudflare could not use it
}

/// What a human has decided about it.
///
/// Moderation is deliberately after publication, resolved with Lisa on 27 July:
/// a video is live the moment it is playable, and is reviewed afterwards.
/// Holding every clip until somebody looks would make the storefront useless to
/// a creator posting on a Friday night.
enum VideoReview {
  PENDING // live, nobody has looked yet
  APPROVED // looked at and kept
  REMOVED // taken down
}

enum SaleSource {
  POSTBACK
  PIXEL
  CSV
  MANUAL
}

// Where the money has physically reached.
enum PayoutStage {
  PENDING // sale in, return window still open
  VERIFIED // return window passed
  PAID_TO_PLUGGZ // brand has settled with Pluggz
  PAID_TO_CREATOR // creator has been paid out
}

model Sale {
  id               String         @id @default(cuid())
  creatorProductId String
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  clickId String? // attribution back to the click that earned it
  click   Click?  @relation(fields: [clickId], references: [id], onDelete: SetNull)

  orderRef   String?
  valuePence Int
  currency   String  @default("GBP")

  status SaleStatus  @default(PENDING)
  stage  PayoutStage @default(PENDING)

  // Defaults to CSV because every sale that existed before this column did
  // arrived through an uploaded report or was entered by hand. Each route sets
  // it explicitly from here on.
  source SaleSource @default(CSV)

  // Rates are snapshotted at sale time. A later change to the global default
  // or an override must never retroactively rewrite historical commission.
  creatorRate        Decimal @db.Decimal(5, 2)
  pluggzRate         Decimal @db.Decimal(5, 2)
  creatorAmountPence Int
  pluggzAmountPence  Int

  soldAt         DateTime  @default(now())
  verifiesAt     DateTime // soldAt + the brand's effective return window
  verifiedAt     DateTime?
  paidToPluggzAt DateTime?

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  disputes Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A brand retrying a webhook, or a checkout firing twice, must not create a
  // second sale for the same order.
  @@unique([creatorProductId, orderRef])
  @@index([status, stage])
  @@index([verifiesAt])
  @@index([creatorProductId, soldAt])
}

enum PayoutStatus {
  SCHEDULED
  SENT
  FAILED
}

// A twice-monthly payout run (1st and 15th) for one creator.
/// Where a payout got to at Stripe, as opposed to what we intended.
///
/// Separate from PayoutStatus, which is the team's own view of a run. A
/// transfer can be created and later reversed, and a record that only said
/// "sent" could not tell that story.
enum TransferState {
  NONE
  SENT
  FAILED
  REVERSED
}

model Payout {
  id        String         @id @default(cuid())
  profileId String
  profile   CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  runDate     DateTime
  amountPence Int
  status      PayoutStatus @default(SCHEDULED)
  reference   String? // a Wise reference, from before Stripe
  sentAt      DateTime?

  /// Stripe's own transfer id, so a payment here can be found in their
  /// dashboard, and so the same run can never be sent twice.
  stripeTransferId String?       @unique
  transferState    TransferState @default(NONE)
  failureReason    String?

  sales Sale[]

  createdAt DateTime @default(now())

  @@unique([profileId, runDate])
  @@index([runDate, status])
}

// Single-row table holding the platform-wide default split.
model PlatformSetting {
  id                 String   @id @default("singleton")
  defaultCreatorRate Decimal  @default(8.00) @db.Decimal(5, 2)
  defaultPluggzRate  Decimal  @default(5.00) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt
}

// Negotiated rate for one creator or one brand. Exactly one of the two
// targets is set; creator overrides win over brand overrides.
/**
 * A lifestyle category: the tiles on the homepage and the pages behind them.
 * `name` is the join key, because Product.category is free text written by the
 * scraper and the importer rather than a foreign key. Renaming a category has
 * to rewrite every product that carries the old name, which the admin route
 * does in one transaction; nothing else may change this column.
 */
/**
 * A product a shopper saved to come back to.
 * Saved as the creator's listing rather than the master product, because on
 * Pluggz the recommendation is the thing: coming back to "the dress Katie
 * plugged" is the point, and the same dress on another storefront is a
 * different card with a different review. It also keeps the creator credited
 * when the shopper eventually buys.
 * Hung off User rather than ShopperProfile so anyone signed in can save,
 * without a role gate turning a browsing creator away from their own site.
 */
model WishlistItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProductId String
  creatorProduct   CreatorProduct @relation(fields: [creatorProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Saving the same card twice is the same save, not two.
  @@unique([userId, creatorProductId])
  @@index([userId, createdAt])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  emoji String @default("")

  /**
   * The tile artwork. Left unset until there is a photograph tall enough for
   * the 4:5 box, since the drawn panel beats a small image stretched to fit.
   */
  coverUrl String?
  videoUrl String?

  sortOrder Int     @default(0)
  inNav     Boolean @default(false) // shown in the header, which has room for three
  active    Boolean @default(true) // hidden everywhere public when false

  // A slot the team can sell to a category sponsor, e.g. a travel brand on
  // Travel. Managed here so a placement can be mocked up for a prospect and
  // switched on the day it is signed.
  bannerImageUrl String?
  bannerHref     String?
  bannerLabel    String?
  bannerActive   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

enum DisputeReason {
  RETURNED_NOT_REPORTED // brand says returned, we were never told
  VALUE_WRONG // the amount reported does not match the order
  NOT_OUR_SALE // the brand says this did not come from Pluggz
  DUPLICATE // reported twice under different references
  CREATOR_QUERY // the creator says something is missing or wrong
  OTHER
}

enum DisputeStatus {
  OPEN
  WITH_BRAND // waiting on the brand to come back
  RESOLVED
  WRITTEN_OFF // dropped, no money moves
}

/**
 * A disagreement about one recorded sale.
 * Every figure on this platform is computed, so when a brand or a creator says
 * a number is wrong there was nowhere to record that, who is waiting on whom,
 * or what was agreed in the end. Deliberately a note against the sale rather
 * than a mechanism: nothing here changes the money. Settling a dispute means
 * changing the sale itself, and that stays a separate, deliberate act.
 */
model Dispute {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  reason DisputeReason
  status DisputeStatus @default(OPEN)

  detail     String // what is being disputed, in plain words
  raisedBy   String // who told us: a brand contact, a creator, or the team
  resolution String? // what was agreed, written when it closes

  openedAt   DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([status, openedAt])
  @@index([saleId])
}

model CommissionOverride {
  id String @id @default(cuid())

  creatorProfileId String?         @unique
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  brandId          String?         @unique
  brand            Brand?          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  creatorRate Decimal @db.Decimal(5, 2)
  pluggzRate  Decimal @db.Decimal(5, 2)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
